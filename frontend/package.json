{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron ../electron/main.js",
    "electron:dev": "electron electron/main.js",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.txstudio.broadcast",
    "productName": "TX-STUDIO Broadcast Suite",
    "copyright": "Copyright \u00a9 2026 TX-STUDIO",
    "directories": {
      "output": "../dist_electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "../favicon.ico"
    ],
    "extraResources": [
      {
        "from": "../dist/start_studio",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../favicon.ico",
        "to": "favicon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TX-STUDIO Broadcast Suite"
    }
  },
  "author": "TX-STUDIO",
  "description": "TX-STUDIO Professional Multicam Broadcast Suite"
}